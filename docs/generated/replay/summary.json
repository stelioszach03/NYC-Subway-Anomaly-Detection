  "feature_highlights": [
    {
      "feature": "hour",
      "why_it_matters": "UTC hour-of-day for strong service-period effects."
    },
    {
      "feature": "day_of_week",
      "why_it_matters": "Weekday context so weekday commute patterns do not look anomalous at baseline."
    },
    {
      "feature": "is_weekend",
      "why_it_matters": "Weekend service patterns differ materially from weekday operations."
    },
    {
      "feature": "is_peak",
      "why_it_matters": "Rush-hour indicator for the AM/PM commute windows."
    },
    {
      "feature": "lag_headway_1",
      "why_it_matters": "Previous observed headway at the same route-stop pair."
    },
    {
      "feature": "lag_headway_2",
      "why_it_matters": "Second-most recent headway for short-memory trend context."
    },
    {
      "feature": "rolling_mean_6",
      "why_it_matters": "Recent local moving average for the route-stop headway."
    },
    {
      "feature": "rolling_std_6",
      "why_it_matters": "Recent local volatility so large swings score higher only when unusual."
    },
    {
      "feature": "rolling_q10_12",
      "why_it_matters": "Lower rolling quantile used to contextualize the current headway band."
    },
    {
      "feature": "rolling_q90_12",
      "why_it_matters": "Upper rolling quantile used to contextualize the current headway band."
    },
    {
      "feature": "station_baseline_deviation",
      "why_it_matters": "Deviation from the recent station-local baseline, scaled by robust MAD."
    },
    {
      "feature": "feed_delay_sec",
      "why_it_matters": "How stale the GTFS event is relative to observation time."
    },
    {
      "feature": "stale_update_flag",
      "why_it_matters": "Binary indicator for delayed/stale feed updates."
    },
    {
      "feature": "direction_code",
      "why_it_matters": "Direction inferred from stop_id suffix when available (for example N/S)."
    },
    {
      "feature": "precipitation_mm",
      "why_it_matters": "Optional weather hook for replay or production enrichment."
    },
    {
      "feature": "service_alert_active",
      "why_it_matters": "Optional service-alert hook for route-level incident context."
    }
  ],
  "artifacts": {
    "events_csv": "events.csv",
    "timeline_json": "timeline.json",
